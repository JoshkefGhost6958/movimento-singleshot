# Kinetic Ledger Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Google Gemini API Configuration
# =============================================================================
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Gemini File Search Corpus Configuration
# Corpus name for motion analysis storage (auto-created if doesn't exist)
FILE_SEARCH_CORPUS_NAME=kinetic-motion-analysis

# =============================================================================
# Circle API Configuration (Phase 2)
# =============================================================================
# Get credentials from: https://console.circle.com/
CIRCLE_API_KEY=<your_circle_api_key>
CIRCLE_ENTITY_SECRET=<your_circle_entity_secret>
CIRCLE_WALLET_SET_ID=<your_wallet_set_id>

# =============================================================================
# Arc RPC Configuration (Phase 2)
# =============================================================================
# Arc testnet RPC endpoint
ARC_RPC_URL=https://rpc.arcscan.io
ARC_TESTNET_RPC_URL=https://rpc.arcscan.io
ARC_CHAIN_ID=1301

# Private key for signing transactions (DO NOT commit this!)
ARC_PRIVATE_KEY=<your_private_key>

# NPCMotionRegistry contract address on Arc testnet
NPC_MOTION_REGISTRY_ADDRESS=0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb0

# =============================================================================
# thirdweb Engine Configuration (Phase 2)
# =============================================================================
# Get credentials from: https://thirdweb.com/dashboard/engine
THIRDWEB_ENGINE_URL=https://engine.thirdweb.com
THIRDWEB_SECRET_KEY=<your_thirdweb_secret_key>
X402_FACILITATOR_URL=https://x402-facilitator.thirdweb.com
PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000001
SERVER_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# Application Configuration
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Port used by docker compose to expose the API
API_PORT=8080

# =============================================================================
# PostgreSQL / pgvector Configuration
# =============================================================================
# Used by docker compose for the db service and by the API for vector storage.
POSTGRES_USER=kinetic
POSTGRES_PASSWORD=<your_db_password>
POSTGRES_DB=kinetic_ledger
POSTGRES_PORT=5432

# Docker service URL (uses compose service name `db` for container networking)
DATABASE_URL=postgresql://kinetic:<your_db_password>@db:5432/kinetic_ledger

# Qdrant configuration (alternative to File Search)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=<your_qdrant_api_key>

# =============================================================================
# Redis Configuration (for queuing/caching)
# =============================================================================
REDIS_PORT=6379
# Docker service URL (uses compose service name `redis` for container networking)
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Object Storage Configuration (Cloudflare R2)
# =============================================================================
# R2 is S3-compatible; endpoint is your account-specific URL.
# Get credentials from: https://dash.cloudflare.com/ > R2 > Manage API tokens
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your_r2_access_key_id>
R2_SECRET_ACCESS_KEY=<your_r2_secret_access_key>
R2_BUCKET_NAME=kinetic-ledger-motions
# Optional public base URL for serving stored objects
# R2_PUBLIC_URL=https://media.example.com

# =============================================================================
# Development / Testing
# =============================================================================
# Set to "true" to enable debug mode
DEBUG=false

# Set to "true" to use mock services when APIs unavailable
USE_MOCK_SERVICES=false

# Pytest configuration
PYTEST_TIMEOUT=300
